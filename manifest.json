{
    "manifest_version": 3,
    "name": "Zanno's Feed Cleanser",
    "version": "1.0",
    "description": "Vaporizes Facebook's algorithmic garbage, suggested posts, and unwanted ads.",
    "icons": {
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.facebook.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}